{
  "include": ["src"],
  "compilerOptions": {
    "target": "es2020",
    "lib": ["es2020", "esnext.disposable", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "isolatedModules": true,
    "noEmit": true
  }
}
